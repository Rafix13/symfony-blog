
{% extends 'base.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}

{% block body %}

<!-- Navigation Bar -->
<nav class="navbar navbar-fixed-top navbar-default">
    <div class="container">
        <div class="navbar-header">
            <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#menu">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
                <span class="icon-bar"></span>
            </button>

            <a class="navbar-brand page-scroll" href="#page-top">
                <span>[PHOTO]</span>
            </a>
        </div>

        <div class="collapse navbar-collapse navbar-right" id="menu">
            <ul class="nav navbar-nav">
                <li class="lien">
                    <a href="{{ path('blog') }}"><i class="fa fa-home sr-icons"></i> Home</a>
                </li>
                <li class="lien">
                    <a href="#"><i class="fa fa-bookmark sr-icons"></i> About</a>
                </li>
                <li class="active lien">
                    <a href="{{ path('blog') }}"><i class="fa fa-file-text sr-icons"></i> Blog</a>
                </li>
                <li>
                    <a href="#"><i class="fa fa-phone-square sr-icons"></i> Contact</a>
                </li>
            </ul>
        </div>
    </div>
</nav>
<!-- End of Navigation Bar -->

<!-- Principal Content Start -->
<div id="single">
    <div class="container">

        {% if not post %}
            <h2>Post not found</h2>
        {% else %}

            <!-- Full Article -->
            <div class="row">
                <h2>{{ post.title }}</h2>
                <hr class="subtitle">

                <div class="block1">
                    <div class="col-xs-12 col-sm-9">

                        {% if post.image %}
                            <img
                                src="{{ asset('images/posts/' ~ post.image) }}"
                                alt="{{ post.title }}"
                                class="img-responsive"
                            >
                        {% endif %}

                        <div class="post-content">
                            {{ post.content|nl2br }}
                        </div>

                        <h4>
                            - By {{ post.postUser ? post.postUser.userIdentifier : 'Usuario desconocido' }}
                        </h4>

                        <hr>

                        <ul class="list-inline">
                            <li>{{ post.publishedAt|date('d F Y') }} ||</li>
                            <li><a class="page-scroll" href="#form">COMMENT</a> |</li>
                            <li><a href="#">LIKE</a></li>
                        </ul>
                    </div>

                    <!-- Recent Posts -->
                    <div class="col-xs-12 col-sm-3">
                        <h4>Recent Post</h4>
                        <hr class="subtitle1">

                        {% for recent in recents %}
                            {{ include('partials/_recent_post.html.twig', {
                                'recent': recent
                            }) }}
                        {% else %}
                            <p>No hay publicaciones recientes.</p>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <!-- End of Full Article -->

            <!-- Comments -->
            <div class="row">
                <div class="col-xs-12 col-sm-12 block2">

                    {# Comentarios de ejemplo del diseño original #}
                    <div class="comment">
                        <h4>Young Papou</h4>
                        <span>
                            <i class="fa fa-star sr-icons"></i>
                            <i class="fa fa-star sr-icons"></i>
                            <i class="fa fa-star sr-icons"></i>
                            <i class="fa fa-star sr-icons"></i>
                            <i class="fa fa-star sr-icons"></i>
                        </span>
                        <p class="time">9:00 AM</p>
                        <hr>
                        <p>
                            Perferendis recusandae consequuntur quasi, non culpa.
                            Minus porro officiis veniam facilis praesentium expedita.
                        </p>
                    </div>

                    <div class="comment alt-comment">
                        <h4>Tom Junky</h4>
                        <span>
                            <i class="fa fa-star sr-icons"></i>
                            <i class="fa fa-star sr-icons"></i>
                            <i class="fa fa-star sr-icons"></i>
                            <i class="fa fa-star sr-icons"></i>
                            <i class="fa fa-star-o sr-icons"></i>
                        </span>
                        <p class="time">5:00 AM</p>
                        <hr>
                        <p>
                            In felis ante, aliquet sit amet venenatis at,
                            feugiat sed leo. Fusce pretium, velit in luctus ornare.
                        </p>
                    </div>

                    <div class="comment">
                        <h4>John Dark</h4>
                        <span>
                            <i class="fa fa-star sr-icons"></i>
                            <i class="fa fa-star sr-icons"></i>
                            <i class="fa fa-star sr-icons"></i>
                            <i class="fa fa-star-o sr-icons"></i>
                            <i class="fa fa-star-o sr-icons"></i>
                        </span>
                        <p class="time">9:00 AM</p>
                        <hr>
                        <p>
                            Class aptent taciti sociosqu ad litora torquent
                            per conubia nostra, per inceptos himenaeos.
                        </p>
                    </div>

                    <hr class="line">

                    <!-- Symfony Comment Form -->
                    {{ include('partials/_post_comments.html.twig') }}

                </div>
            </div>
            <!-- End of Comments -->

        {% endif %}

    </div>
</div>
<!-- End of Principal Content -->

<!-- Footer -->
<footer>
    <div class="container text-muted text-center">
        <ul class="list-inline social-buttons">
            <li><a href="#"><i class="fa fa-facebook sr-icons"></i></a></li>
            <li><a href="#"><i class="fa fa-twitter sr-icons"></i></a></li>
            <li><a href="#"><i class="fa fa-google-plus sr-icons"></i></a></li>
        </ul>

        <ul class="list-inline">
            <li class="footer-number">
                <i class="fa fa-phone sr-icons"></i> (00228)92229954
            </li>
            <li>
                <i class="fa fa-envelope sr-icons"></i> kouvenceslas93@gmail.com
            </li>
        </ul>

        <p>Photography Fanatic Template &copy; 2017</p>
    </div>
</footer>
<!-- End of Footer -->

{% endblock %}
